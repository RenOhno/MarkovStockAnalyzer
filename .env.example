# Copy to .env locally and fill the three secrets with independent random values.
# Do not commit .env. Empty secrets intentionally prevent Compose startup.
MYSQL_DATABASE=markov_stock_analyzer
MYSQL_USER=msa
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
INTERNAL_API_TOKEN=
BACKEND_PORT=8080
# Must match analysis/uv.lock and the deployed exchange-calendars distribution.
MARKET_CALENDAR_VERSION=4.13.2
